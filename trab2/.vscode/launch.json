{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "P16 GDB (TCP)",
      "type": "p16-gdb",
      "request": "launch",
      "preLaunchTask": "P16: P16 Build",
      "program": "${fileDirname}/${fileBasenameNoExtension}.elf",
      "gdbPath": "p16-none-elf-gdb",
      "target": "localhost:3333",
      "stopOnEntry": true
    },
    {
      "name": "P16 GDB (Serial)",
      "type": "p16-gdb",
      "request": "launch",
      "preLaunchTask": "P16: P16 Build",
      "program": "${fileDirname}/${fileBasenameNoExtension}.elf",
      "gdbPath": "p16-none-elf-gdb",
      "target": "auto",
      "baudrate": 115200
    }
  ]
}